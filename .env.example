# ====================================================================
# Entregas RD — variables de entorno (copia este archivo a .env)
# ====================================================================
NODE_ENV=development
PORT=3000
# URL pública (se usa en los enlaces de seguimiento que recibe el cliente)
PUBLIC_BASE_URL=http://localhost:3000

# --- Seguridad (OBLIGATORIAS en producción) ---
# Genera valores con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
DATA_ENCRYPTION_KEY=
SESSION_HOURS=12
# HTTPS obligatorio (por defecto true en producción). Detrás de un proxy (Nginx, Render, etc.):
FORCE_HTTPS=false
TRUST_PROXY=1

# --- Base de datos ---
# Desarrollo: SQLite (archivo en server/data). Producción: PostgreSQL.
DB_CLIENT=better-sqlite3
# DB_CLIENT=pg
# DATABASE_URL=postgres://usuario:clave@host:5432/logistica
# Supabase en la nube exige SSL:
# DB_SSL=true

# --- Redis (opcional; recomendado en producción) ---
# REDIS_URL=redis://:clave@localhost:6379

# --- Primer administrador (instalación vacía, sin datos de ejemplo) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# --- Google Maps Platform (opcional) ---
# Sin clave de navegador los mapas usan OpenFreeMap (gratis, sin clave).
# Clave PÚBLICA del navegador: restríngela por HTTP referrer (tu dominio) y por API
# (Maps JavaScript API y Places API (New)).
GOOGLE_MAPS_BROWSER_KEY=
# Map ID (necesario para marcadores avanzados). DEMO_MAP_ID sirve para pruebas.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Clave PRIVADA del servidor (nunca llega al navegador): restríngela por IP del servidor
# y por API (Geocoding API y Routes API).
GOOGLE_MAPS_SERVER_KEY=

# --- Web Push (opcional: si se omiten se generan y guardan automáticamente) ---
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@tuempresa.com

# --- Canales externos futuros (opcionales) ---
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMS_PROVIDER_API_KEY=
SMTP_URL=

# Carpeta de evidencias de entrega (fotos y firmas)
# UPLOADS_DIR=/var/lib/logistica/uploads
