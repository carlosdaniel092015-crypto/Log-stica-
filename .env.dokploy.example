# =====================================================================
# Variables para Dokploy o Easypanel (pestaña "Environment" del servicio Compose).
# Genera cada secreto con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   (o: openssl rand -hex 32)
# =====================================================================

# URL pública con HTTPS (el dominio que asignes al servicio "app").
# Si el frontend está en Vercel, pon aquí el dominio de Vercel.
PUBLIC_BASE_URL=https://entregas.tudominio.com
# Otros dominios del frontend que pueden abrir el tiempo real (separados por coma). Opcional.
CORS_ORIGINS=

# Seguridad de la aplicación (obligatorias)
JWT_SECRET=cambia-esto-por-un-secreto-largo
DATA_ENCRYPTION_KEY=cambia-esto-por-otro-secreto-largo

# Supabase (PostgreSQL) — contraseña del usuario postgres y supabase_admin
POSTGRES_PASSWORD=cambia-esta-clave-de-base-de-datos
# Clave para cifrar conexiones guardadas en Supabase Studio (32+ caracteres)
PG_META_CRYPTO_KEY=cambia-esto-por-32-caracteres-o-mas

# Redis
REDIS_PASSWORD=cambia-esta-clave-de-redis

# Primer administrador (se crea solo si la base está vacía)
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=UnaClaveFuerte123!
ADMIN_NAME=Administrador

# true = carga datos de ejemplo de RD SOLO si la base está vacía (para probar)
LOAD_DEMO_DATA=false

# Google Maps Platform
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Sin GOOGLE_MAPS_SERVER_KEY, la dirección escrita de una ubicación pegada sale de
# OpenStreetMap (gratis). Pon false para no usarlo.
OSM_GEOCODER=true

# Web Push (opcional; si se omiten se generan y guardan en la base)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@tudominio.com

# HTTPS lo termina Traefik (Dokploy/Easypanel); la app confía en el proxy.
# Con el frontend en Vercel usa TRUST_PROXY=2 (Vercel + Traefik).
FORCE_HTTPS=true
TRUST_PROXY=1

# Puerto local (solo 127.0.0.1) para Supabase Studio
STUDIO_PORT=3001
